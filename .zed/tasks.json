[
  {
    "label": "🧹 Clean",
    "command": "rm -rf build",
    "use_new_terminal": false,
    "reveal": "never",
  },
  {
    "label": "▶️ Run",
    "command": "./app",
    "cwd": "$ZED_WORKTREE_ROOT/build/bin",
    "use_new_terminal": false,
    "reveal": "always",
  },
  {
    "label": "🛠️ Ninja - Configure (Debug)",
    "command": "scripts/ninja_gen_debug.sh",
    "use_new_terminal": false,
    "reveal": "always",
  },
  {
    "label": "🔨 Ninja - Build (Debug)",
    "command": "scripts/ninja_build_debug.sh",
    "use_new_terminal": false,
    "reveal": "always",
  },
  {
    "label": "🔄 Ninja - Re-Build (Debug)",
    "command": "scripts/ninja_incremental_build_debug.sh",
    "use_new_terminal": false,
    "reveal": "always",
  },
  {
    "label": "⚡ Ninja - Clear & Build (Debug)",
    "command": "scripts/ninja_clear_build_debug.sh",
    "use_new_terminal": false,
    "reveal": "always",
  },
  {
    "label": "⚡ Ninja - Clear & Build (Release)",
    "command": "scripts/ninja_clear_build_release.sh",
    "use_new_terminal": false,
    "reveal": "always",
  },
