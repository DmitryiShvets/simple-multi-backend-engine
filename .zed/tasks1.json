[
  {
    "label": "🧹 Clean",
    "command": "if (Test-Path build) { Remove-Item -Recurse -Force build }",
    "use_new_terminal": false,
    "reveal": "never",
  },
  {
    "label": "▶️ Run",
    "command": "./app",
    "cwd": "$ZED_WORKTREE_ROOT/build/bin",
    "use_new_terminal": false,
    "reveal": "never",
  },
  {
    "label": "🛠️ Ninja - Configure (Debug)",
    "command": "scripts/ninja_gen_debug.bat",
    "use_new_terminal": false,
    "reveal": "always",
  },
  {
    "label": "🔨 Ninja - Build (Debug)",
    "command": "scripts/ninja_build_debug.bat",
    "use_new_terminal": false,
    "reveal": "always",
  },
  {
    "label": "🔄 Ninja - Re-Build (Debug)",
    "command": "scripts/ninja_incremental_build_debug.bat",
    "use_new_terminal": false,
    "reveal": "always",
  },
  {
    "label": "⚡ Ninja - Configure & Build (Debug)",
    "command": "scripts/ninja_clear_build_debug.bat",
    "use_new_terminal": true,
    "reveal": "always",
  },
  {
    "label": "⚡ Ninja - Configure & Build (Release)",
    "command": "scripts/ninja_clear_build_release.bat",
    "use_new_terminal": true,
    "reveal": "always",
  },
]
